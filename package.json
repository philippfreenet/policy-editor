  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/chai": "5.2.3",
    "@types/diff": "7.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sinon": "22.0.2",
    "@vitejs/plugin-react": "6.2.1",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "diff": "9.0.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "sinon": "22.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
